{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness-forge:schema:runtime-cases",
  "title": "Runtime activation cases for built skills (evals/smoke/*.yaml)",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 100
          },
          "part_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]*$"
          },
          "mode": {
            "enum": [
              "explicit",
              "implicit",
              "negative"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "expected": {
            "enum": [
              "activates",
              "does-not-activate"
            ]
          },
          "permitted_tools": {
            "type": "object",
            "properties": {
              "claude-code": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true
              },
              "codex": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "fixtures": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": {
              "type": "string",
              "maxLength": 200000
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "part_id",
          "mode",
          "prompt",
          "expected",
          "permitted_tools"
        ]
      }
    },
    "behavior": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 100
          },
          "part_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]*$"
          },
          "mode": {
            "enum": [
              "explicit",
              "implicit"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "harnesses": {
            "type": "array",
            "items": {
              "enum": [
                "claude-code",
                "codex"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "fixtures": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": {
              "type": "string",
              "maxLength": 200000
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "network": {
            "const": "none"
          },
          "git": {
            "description": "A repository in the workspace, its commits made one at a time before the run (#111).",
            "type": "object",
            "properties": {
              "commits": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "files": {
                      "type": "object",
                      "minProperties": 1,
                      "maxProperties": 50,
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 200000
                      }
                    }
                  },
                  "required": [
                    "message",
                    "files"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "commits"
            ],
            "additionalProperties": false
          },
          "links": {
            "description": "Symbolic links Forge creates before the run, to a target in the workspace or outside it (#111).",
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "in": {
                  "enum": [
                    "workspace",
                    "outside"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "kind": {
                  "enum": [
                    "file",
                    "directory",
                    "missing"
                  ]
                }
              },
              "required": [
                "in",
                "path",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "checks": {
            "description": "What the case checks: the part's accepted requirement ids and/or goal (#110).",
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(goal|idea\\.[a-z0-9-]+\\.[a-z0-9]+\\.[a-z0-9-]+)$",
              "maxLength": 200
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "glob": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "exists": {
                      "const": true
                    },
                    "absent": {
                      "const": true
                    },
                    "equals": {
                      "type": "string",
                      "maxLength": 200000
                    },
                    "contains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "minItems": 1,
                      "maxItems": 50
                    },
                    "not_contains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "minItems": 1,
                      "maxItems": 50
                    },
                    "only_in": {
                      "description": "Each text occurs, and only inside the named section, optionally in a fence (#112).",
                      "type": "object",
                      "properties": {
                        "heading": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "level": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 6
                        },
                        "fenced": {
                          "type": "boolean"
                        },
                        "texts": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 50,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          }
                        }
                      },
                      "required": [
                        "heading",
                        "texts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "path"
                      ]
                    },
                    {
                      "required": [
                        "glob"
                      ]
                    }
                  ],
                  "minProperties": 2
                }
              },
              "actions": {
                "type": "object",
                "properties": {
                  "no_tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "no_denied": {
                    "const": true
                  },
                  "no_commands_matching": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "no_output_containing": {
                    "description": "Texts no tool result or command output in the recorded run may contain (#112).",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "no_file_requests_matching": {
                    "description": "Patterns no Claude Code file-tool request's path may match, refused ones too (#112).",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "shell": {
            "description": "The case needs a shell. Only Claude Code cases may ask; today they are not run, since its sandbox cannot be shown to keep writes to the declared paths (#113).",
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "part_id",
          "mode",
          "prompt",
          "harnesses",
          "network",
          "expect"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "cases"
  ]
}
