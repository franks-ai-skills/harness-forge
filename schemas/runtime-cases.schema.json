{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness-forge:schema:runtime-cases",
  "title": "Runtime activation cases for built skills (evals/smoke/*.yaml)",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 100
          },
          "part_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]*$"
          },
          "mode": {
            "enum": [
              "explicit",
              "implicit",
              "negative"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "expected": {
            "enum": [
              "activates",
              "does-not-activate"
            ]
          },
          "permitted_tools": {
            "type": "object",
            "properties": {
              "claude-code": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true
              },
              "codex": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "fixtures": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": {
              "type": "string",
              "maxLength": 200000
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "part_id",
          "mode",
          "prompt",
          "expected",
          "permitted_tools"
        ]
      }
    },
    "behavior": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 100
          },
          "part_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]*$"
          },
          "mode": {
            "enum": [
              "explicit",
              "implicit"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "harnesses": {
            "type": "array",
            "items": {
              "enum": [
                "claude-code",
                "codex"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "fixtures": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": {
              "type": "string",
              "maxLength": 200000
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 20,
            "uniqueItems": true
          },
          "network": {
            "const": "none"
          },
          "checks": {
            "description": "What the case checks: the part's accepted requirement ids and/or goal (#110).",
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(goal|idea\\.[a-z0-9-]+\\.[a-z0-9]+\\.[a-z0-9-]+)$",
              "maxLength": 200
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "glob": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "exists": {
                      "const": true
                    },
                    "absent": {
                      "const": true
                    },
                    "equals": {
                      "type": "string",
                      "maxLength": 200000
                    },
                    "contains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "minItems": 1,
                      "maxItems": 50
                    },
                    "not_contains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "minItems": 1,
                      "maxItems": 50
                    }
                  },
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "path"
                      ]
                    },
                    {
                      "required": [
                        "glob"
                      ]
                    }
                  ],
                  "minProperties": 2
                }
              },
              "actions": {
                "type": "object",
                "properties": {
                  "no_tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "no_denied": {
                    "const": true
                  },
                  "no_commands_matching": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "part_id",
          "mode",
          "prompt",
          "harnesses",
          "network",
          "expect"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "cases"
  ]
}
