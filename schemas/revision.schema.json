{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-forge:schema:revision",
  "title": "Accepted Idea KB revision (.harness/research/<slug>.rules.yaml)",
  "type": "object",
  "properties": {
    "brief_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]*$"
          },
          "rule": {
            "$ref": "urn:harness-forge:schema:rule"
          }
        },
        "additionalProperties": false,
        "required": [
          "part_id",
          "rule"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "brief_digest",
    "digest",
    "rules"
  ]
}
