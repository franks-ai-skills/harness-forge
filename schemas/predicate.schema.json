{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness-forge:schema:predicate",
  "title": "Closed fact predicate: all/any/not/eq/in over declared facts",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "urn:harness-forge:schema:predicate#"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "all"
      ]
    },
    {
      "type": "object",
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "urn:harness-forge:schema:predicate#"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "any"
      ]
    },
    {
      "type": "object",
      "properties": {
        "not": {
          "$ref": "urn:harness-forge:schema:predicate#"
        }
      },
      "additionalProperties": false,
      "required": [
        "not"
      ]
    },
    {
      "type": "object",
      "properties": {
        "eq": {
          "type": "array",
          "items": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 100
            },
            {
              "type": [
                "string",
                "boolean",
                "integer"
              ]
            }
          ],
          "minItems": 2,
          "additionalItems": false
        }
      },
      "additionalProperties": false,
      "required": [
        "eq"
      ]
    },
    {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 100
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "boolean",
                  "integer"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "minItems": 2,
          "additionalItems": false
        }
      },
      "additionalProperties": false,
      "required": [
        "in"
      ]
    }
  ]
}
