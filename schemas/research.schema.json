{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-forge:schema:research",
  "title": "Research record frontmatter (.harness/research/<slug>.md)",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "search_mode": {
      "enum": [
        "live",
        "cached"
      ]
    },
    "briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pass": {
            "enum": [
              "survey",
              "deep"
            ]
          },
          "part_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][0-9]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "pass",
          "part_id",
          "digest"
        ]
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "quote_check": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "verdict": {
            "enum": [
              "supported",
              "unsupported",
              "missing"
            ]
          },
          "worker_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "finding_id",
          "quote_check",
          "verdict",
          "worker_ref"
        ]
      }
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "maxLength": 200
          },
          "finding_id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "category": {
            "enum": [
              "security",
              "compatibility",
              "ordinary"
            ]
          },
          "issue": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2000
              },
              {
                "enum": [
                  "pending",
                  "not published"
                ]
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "rule_id",
          "finding_id",
          "summary",
          "category"
        ]
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "slug",
    "search_mode",
    "briefs",
    "findings",
    "support",
    "drift"
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]+$"
        },
        "pass": {
          "enum": [
            "survey",
            "deep"
          ]
        },
        "part_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "source": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2000
        },
        "fetched": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "brief_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_role": {
          "enum": [
            "primary",
            "practitioner",
            "trade-press"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "pass",
        "part_id",
        "claim",
        "source",
        "fetched",
        "quote",
        "context",
        "brief_digest",
        "source_role"
      ]
    }
  }
}
