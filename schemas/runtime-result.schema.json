{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness-forge:schema:runtime-result",
  "title": "One runtime test of a built artifact",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "part_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "expected": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "observed_activation": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "error",
        "not-run",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "file_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "harness": {
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "inventory": {
      "enum": [
        "observed",
        "not observable"
      ]
    },
    "kind": {
      "enum": [
        "activation",
        "behavior"
      ]
    },
    "details": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "failed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maxItems": 100
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "maxItems": 500
            },
            "requests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maxItems": 500
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maxItems": 500
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maxItems": 20
            },
            "case_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "failed",
            "changes",
            "requests",
            "denied",
            "gaps",
            "case_digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "run_id",
    "part_id",
    "case_id",
    "prompt",
    "expected",
    "observed_activation",
    "result",
    "reason",
    "file_hashes",
    "harness",
    "harness_version",
    "environment"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "unavailable"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "behavior"
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "behavior"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "details": {
            "type": "object"
          }
        },
        "required": [
          "details"
        ]
      },
      "else": {
        "properties": {
          "details": {
            "type": "null"
          }
        }
      }
    }
  ]
}
