{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:harness-forge:schema:report",
  "title": "Verification report data",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kb_version": {
      "type": "string",
      "minLength": 1
    },
    "idea_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rules_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_parts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][0-9]*$"
      },
      "uniqueItems": true
    },
    "whole_idea": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reach": {
          "enum": [
            "repository",
            "user",
            "public"
          ]
        },
        "hosting": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "visibility": {
              "enum": [
                "public",
                "private",
                "unknown"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "platform",
            "plan",
            "visibility"
          ]
        },
        "facts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 100
          },
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "targets",
        "reach",
        "hosting",
        "facts"
      ]
    },
    "answers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 100
        },
        "additionalProperties": {
          "type": [
            "string",
            "boolean",
            "integer"
          ]
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "rule_id",
          "digest"
        ]
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "urn:harness-forge:schema:report#/definitions/part_result"
      }
    },
    "runtime_results": {
      "type": "array",
      "items": {
        "$ref": "urn:harness-forge:schema:runtime-result"
      }
    },
    "worker_evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:harness-forge:schema:worker-evidence"
      }
    },
    "changed_judgments": {
      "description": "Reviewer verdicts that changed although the part's review inputs did not (#108).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "earlier": {"$ref": "#/definitions/judgment"},
          "current": {"$ref": "#/definitions/judgment"}
        },
        "required": ["part_id", "rule_id", "earlier", "current"],
        "additionalProperties": false
      }
    },
    "review_attempts": {
      "description": "Present only when the first review reply was rejected: each review launch and its outcome.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "attempt": {
            "enum": [
              1,
              2
            ]
          },
          "outcome": {
            "enum": [
              "rejected",
              "accepted",
              "failed"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence": {
            "$ref": "urn:harness-forge:schema:worker-evidence"
          }
        },
        "additionalProperties": false,
        "required": [
          "attempt",
          "outcome",
          "evidence"
        ]
      }
    },
    "worker_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "file_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "symlinks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "bound_inputs": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "symlinks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "kb_version": {
          "type": "string"
        },
        "rules": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "overrides": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "idea": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minProperties": 1
        },
        "checkers": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "worker": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "symlinks",
        "kb_version",
        "rules",
        "overrides",
        "revision",
        "idea",
        "parts",
        "checkers",
        "worker"
      ]
    },
    "part_map": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "dirs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "requirement_parts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "dependency_roots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "dirs",
        "links",
        "requirement_parts"
      ]
    },
    "scope_parts": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "builds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "forge": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "commit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "tree": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "version",
              "source",
              "commit",
              "tree"
            ],
            "additionalProperties": false
          },
          "outputs_changed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 64
          }
        },
        "required": [
          "forge",
          "outputs_changed"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "run_id",
    "decision_digest",
    "contract_digest",
    "kb_version",
    "idea_digest",
    "rules_digest",
    "revision_digest",
    "confirmed_parts",
    "whole_idea",
    "answers",
    "scope",
    "overrides",
    "parts",
    "runtime_results",
    "worker_evidence",
    "worker_violations",
    "tool_versions",
    "file_hashes",
    "symlinks"
  ],
  "definitions": {
    "judgment": {
      "type": "object",
      "properties": {
        "result": {"type": "string", "minLength": 1},
        "reason": {"type": "string"},
        "attempt_id": {"type": ["string", "null"]},
        "run_id": {"type": "string", "minLength": 1}
      },
      "required": ["result", "reason", "attempt_id", "run_id"],
      "additionalProperties": false
    },
    "part_result": {
      "type": "object",
      "properties": {
        "part_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]*$"
        },
        "status": {
          "enum": [
            "decided",
            "built",
            "verified",
            "blocked"
          ]
        },
        "harness_result": {
          "enum": [
            "verified",
            "not verified",
            "not applicable",
            "not checked"
          ]
        },
        "goal_result": {
          "enum": [
            "not assessed",
            "not met",
            "depends on outside controls",
            "met by the verified build"
          ]
        },
        "outside_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
                "maxLength": 200
              },
              "check": {
                "enum": [
                  "script",
                  "judged"
                ]
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "not-applicable",
                  "unresolved",
                  "error",
                  "missing"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "rule_id",
              "check",
              "result"
            ]
          }
        },
        "goal_verdict": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "verdict": {
                  "enum": [
                    "met",
                    "not-met"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "additionalProperties": false,
              "required": [
                "verdict",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "part_id",
        "status",
        "harness_result",
        "goal_result",
        "outside_dependencies",
        "rule_results",
        "goal_verdict"
      ]
    }
  }
}
