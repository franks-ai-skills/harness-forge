{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-forge:schema:catalog",
  "title": "Checker catalog: ids, implementation versions and parameter schemas",
  "type": "object",
  "properties": {
    "checkers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "params": {
            "type": "object",
            "required": [
              "type",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "summary",
          "params"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "checkers"
  ]
}
